# Copy to .env.local (gitignored) and fill in. Never commit real keys.
# Everything is optional: leave a group blank and that part runs on demo fallbacks.

# --- Supabase (database, realtime, photo storage) ---------------------------
# Blank = in-browser mock data (resets on reload). To use Supabase:
# run supabase/schema.sql then supabase/seed.sql in the SQL editor, then copy
# Project Settings > API > Project URL and the anon public key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude vision (triage, routing, written report, photo matching) --------
# Blank = keyword-based demo triage. Server-side only, never sent to the browser.
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
