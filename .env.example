# Copy to .env.local (gitignored). Never commit real keys.
# Leave everything blank to run fully on mock data (in-memory store + keyword triage).

# Claude computer vision: triage, routing, the written report, and photo matching.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Supabase (run supabase/schema.sql first). Service role key stays server-side.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
